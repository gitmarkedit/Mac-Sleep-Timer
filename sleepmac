#!/usr/bin/env python3
"""sleepmac — терминальный таймер сна для macOS с интерактивным TUI интерфейсом.

Примеры запуска:
  ./sleepmac              # Интерактивное меню с кнопками
  ./sleepmac 30m          # Прямой запуск на 30 минут
  ./sleepmac 1h           # Прямой запуск на 1 час
  ./sleepmac 45           # 45 минут
  ./sleepmac 10s --dry-run # Тестовый режим без фактического сна
"""

import os
import sys

# Разрешаем реальный путь к директории со скриптом (даже если sleepmac запущен через symlink)
_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)

from sleep_timer.cli import main

if __name__ == "__main__":
    main()
